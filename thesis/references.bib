@article{guo2025gatddpg,
  author  = {Guo, Chen and Jiang, Changxu and Liu, Chenxi},
  title   = {Dynamic Reconfiguration Method of Active Distribution Networks Based on Graph Attention Network Reinforcement Learning},
  journal = {Energies},
  volume  = {18},
  number  = {8},
  pages   = {2080},
  year    = {2025},
  doi     = {10.3390/en18082080},
  note    = {[CONFIRMED: publisher page read 2026-07-13. Fuzhou University;
             submitted 4 Mar 2025, published 17 Apr 2025.] MOST ACUTE PRIOR ART
             for the graph-attention component. GATDDPG: graph attention as the
             actor-critic function approximator inside DDPG, solving active
             distribution network dynamic reconfiguration on an enhanced IEEE
             33-bus system. DISTINCTION (verified against the full text): its
             objective is network loss plus voltage deviation under normal
             operation, not disruption response; "dynamic" means 24 hourly
             snapshots (their T = 24 h, 1 h per step), not a continuous
             transient; switching cost is a COUNT of breaker operations
             (their Eq. 12) with no time dimension; the GAT is an end-to-end
             learned policy, not a screening surrogate feeding an exact
             optimizer; and there is no reachability verification of any kind.}
}

